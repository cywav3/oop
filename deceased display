package cemeteryproejct;

import java.util.ArrayList;

public class DeceasedView {

    public static ArrayList<Deceased> getAllForAdminOrVisitor() {
        return Deceased.getList();
    }

    public static ArrayList<Deceased> getForGuardian(String username) {

        ArrayList<Deceased> list = Deceased.getList();
        ArrayList<Deceased> result = new ArrayList<>();

        for (int i = 0; i < list.size(); i++) {
            Deceased d = list.get(i);

            if (d.getOwner().equals(username)) {
                result.add(d);
            }
        }

        return result;
    }
}
